#############################################################################
# AMS-02 primary spectra: protons, 4He, deuterons and 3He in one session.
#
# Every /run/beamOn is a separate Geant4 run and all runs are written to the
# same output file, where they are distinguished by the run number:
#
#     G4Run0  protons     AMS_Proton     Min 12.40 GeV
#     G4Run1  4He         AMS_Helium4    Min 23.13 GeV
#     G4Run2  deuterons   AMS_Deuteron   Min 11.56 GeV
#     G4Run3  3He         AMS_Helium3    Min 23.94 GeV
#
# The spectra are built by CreatePCRSpectrum.cxx, whose header documents the
# data sources and the decomposition of the measured Z = 1 and Z = 2 fluxes.
# The minimum kinetic energies correspond to the 13.3 GV vertical geomagnetic
# cutoff at Zhaoqing through E_k = sqrt((Z R_c)^2 + M^2) - M; they differ
# between species because the kinetic energy is not proportional to the
# rigidity for different masses.
#############################################################################

#############################################################################
# Initialization settings
#############################################################################

/control/verbose 0
/run/verbose 0

#/Mustard/Detector/Description/Emport MusAirS.yaml

/run/initialize

/MusAirS/Action/SwitchToPCR
/MusAirS/PCR/Energy/Sampling/Mode            LogUniformBiased
/MusAirS/PCR/Direction/Sampling/Mode         ZenithPowerBiased

/run/setCutForAGivenParticle e+ 1 pc
/run/setCutForAGivenParticle e- 1 pc
/run/setCutForAGivenParticle gamma 1 pc
/MusAirS/Action/KillEMShower yes
/MusAirS/SD/EarthSD/DetectNeutrino no
/MusAirS/Analysis/SavePrimaryVertexData no

#############################################################################
# Runs
#############################################################################

/Mustard/Analysis/FilePath MusAirS_AMS_lite.root
/Mustard/Analysis/FileMode NEW

# --- protons ---
/MusAirS/PCR/Particle                        proton
/MusAirS/PCR/Energy/Spectrum/Histogram       primary_cosmic_ray.root AMS_Proton
/MusAirS/PCR/Energy/Min                      12.40 GeV
/run/beamOn 10000

# --- helium-4 ---
/MusAirS/PCR/Particle                        alpha
/MusAirS/PCR/Energy/Spectrum/Histogram       primary_cosmic_ray.root AMS_Helium4
/MusAirS/PCR/Energy/Min                      23.13 GeV
/run/beamOn 10000

# --- deuterons ---
/MusAirS/PCR/Particle                        deuteron
/MusAirS/PCR/Energy/Spectrum/Histogram       primary_cosmic_ray.root AMS_Deuteron
/MusAirS/PCR/Energy/Min                      11.56 GeV
/run/beamOn 10000

# --- helium-3 ---
/MusAirS/PCR/Particle                        He3
/MusAirS/PCR/Energy/Spectrum/Histogram       primary_cosmic_ray.root AMS_Helium3
/MusAirS/PCR/Energy/Min                      23.94 GeV
/run/beamOn 10000

/Mustard/Run/PrintRunSummary
